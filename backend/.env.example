# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/online-teaching-platform

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration - Zeabur Email API (recommended)
EMAIL_PROVIDER=zeabur
ZEABUR_EMAIL_API_KEY=zs_your_zeabur_email_api_key
ZEABUR_EMAIL_FROM=noreply@your-verified-domain.com
# Optional API override; normally leave this unchanged
ZEABUR_EMAIL_API_URL=https://api.zeabur.com/api/v1/zsend/emails
EMAIL_FROM_NAME=MeritAI

# Optional legacy Brevo SMTP fallback (set EMAIL_PROVIDER=brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASSWORD=your-brevo-smtp-password
EMAIL_FROM=noreply@your-verified-domain.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CORS
FRONTEND_URL=http://localhost:3000

# WebRTC/Socket
SOCKET_PORT=5001
